# Copy this file to .env and fill in real values. Never commit .env itself.

# --- PostgreSQL + pgvector (single Docker service "postgres" in
# docker-compose.yml - migrated 2026-07-26 off the old two-service MySQL +
# separate "vectorstore" setup, see docs/PROGRESS.md). Holds every table,
# including disclosure_chunks (the vector table src/retrieval/ uses) - no
# more separate PGVECTOR_* variables, src/core/config.py aliases those to
# the DB_* values below since it's the same database now. ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thesis_fin_qa
DB_USER=thesis_user
DB_PASSWORD=change_me

# --- LLM / embeddings ---
# Embedding model (src/retrieval/embeddings.py) is BAAI/bge-m3, runs local
# via sentence-transformers - no API key needed.
# Optional demo override for a troublesome Apple Silicon MPS runtime:
# FINEX_EMBEDDING_DEVICE=cpu   # accepted: auto (default), cpu, mps, cuda
# LLM for RAG answer synthesis (src/models/llm_factory.py, Step 12): local
# Qwen3 served via Ollama (https://ollama.com) - `brew install ollama`,
# Optional live-demo responsiveness budget; defaults retain 180 seconds / 2 retries:
# FINEX_LLM_TIMEOUT_S=45
# FINEX_LLM_RETRIES=0
# `ollama pull qwen3:8b`, no key needed. OLLAMA_HOST only needs overriding
# if you run Ollama somewhere other than localhost (e.g. inside Docker
# later). OPENAI_API_KEY below is only a fallback if you ever want to
# compare against a paid API instead - not required for the current scope.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OPENAI_API_KEY=

# --- Chạy toàn bộ stack bằng Docker (2026-08-20, xem docs/DOCKER.md) -----
#
# OLLAMA_HOST ở TRÊN là cho việc chạy script THẲNG trên máy (localhost).
# Biến dưới đây là cho các container - CỐ Ý tên khác, vì nếu dùng chung
# một tên thì container sẽ nhặt phải "localhost" và gọi vào chính nó.
# Để trống = dùng container ollama do compose dựng lên.
# Đặt http://host.docker.internal:11434 để dùng Ollama.app native trên
# máy - trên Mac Apple Silicon bản native NHANH HƠN NHIỀU vì Docker
# Desktop không truy cập được GPU (xem docs/DOCKER.md §"Ollama và GPU").
OLLAMA_HOST_DOCKER=

# Cổng giao diện web (nginx). Đổi nếu 8443 đã bị chiếm.
WEB_PORT=8443
WEB_PORT_HTTP=8480

# WITH_RAG=0 để build image API nhẹ (~600MB thay vì ~4-6GB) khi chỉ cần
# demo 4 nhánh DAG/whatif/causal/compare mà bỏ nhánh RAG (RAG cần torch +
# sentence-transformers).
WITH_RAG=1

# --- Market snapshot (scripts/market_snapshot.py, thesis_market_snapshot DAG) ---
# VN-Index/gold/forex/per-ticker price come from vnstock (no key needed).
# Oil price (WTI, series DCOILWTICO) comes from FRED - register your own
# free key at https://fred.stlouisfed.org/docs/api/api_key.html (a data-
# access key, not a login). Leave blank to skip oil ingestion.
FRED_API_KEY=
