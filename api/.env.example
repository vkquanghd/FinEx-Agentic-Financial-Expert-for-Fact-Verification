# Sao chép thành api/.env rồi sửa. KHÔNG commit api/.env.

# --- Admin plane ---
# BẮT BUỘC nếu muốn dùng /api/admin/*. Sinh key ngẫu nhiên:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Để trống thì admin service trả 503 cho mọi route - fail-closed có chủ ý.
# KHÔNG bao giờ lộ ra trình duyệt - gateway tự gắn key này khi forward
# request của một phiên đăng nhập role=admin đã xác thực (xem
# api/services/gateway/auth.py). Người dùng cuối chỉ cần đăng nhập
# admin/admin trên giao diện, không bao giờ cần biết giá trị key này.
ADMIN_API_KEY=

# --- Đăng nhập (2 tài khoản demo: user/user, admin/admin) ---
# BẮT BUỘC. Sinh key ngẫu nhiên (khác với ADMIN_API_KEY, dùng riêng để ký
# cookie phiên đăng nhập):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Để trống thì /api/auth/login trả 503 - fail-closed. Đặt CỐ ĐỊNH (không
# để service tự sinh ngẫu nhiên lúc khởi động) vì gateway chạy --reload -
# secret đổi mỗi lần nạp lại code sẽ đăng xuất người dùng liên tục.
SESSION_SECRET=

# --- Cổng nội bộ (chỉ đổi khi bị trùng cổng) ---
QA_SERVICE_URL=http://127.0.0.1:8101
FEEDBACK_SERVICE_URL=http://127.0.0.1:8102
ADMIN_SERVICE_URL=http://127.0.0.1:8103
GATEWAY_PORT=8443

# --- TLS ---
# Đường dẫn tuyệt đối hoặc tương đối tới api/. Sinh chứng chỉ dev bằng
# api/certs/generate_dev_certs.sh
SSL_CERTFILE=certs/dev-cert.pem
SSL_KEYFILE=certs/dev-key.pem

# --- Cổng retrain HITL (khớp migration 013) ---
RETRAIN_GATE_MIN_FEEDBACK=50
RETRAIN_GATE_MEAN_RATING=3.5

# --- DB ---
# src/core/config.py đọc .env Ở GỐC REPO cho phần Postgres/pgvector/Ollama.
# File này KHÔNG lặp lại chúng - một nguồn cấu hình DB duy nhất.
